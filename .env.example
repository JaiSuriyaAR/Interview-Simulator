# =============================================================================
# InterviewPulse Environment Configuration
# Copy this file to .env before starting the application:
#   cp .env.example .env
# =============================================================================

# [REQUIRED] Google Gemini API Key for real-time voice interview & debrief analysis
# Get an API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [OPTIONAL] MongoDB connection string (for persisting user accounts and interview transcripts)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/interviewpulse
MONGODB_URI=

# [OPTIONAL] JWT secret string for signing auth tokens (defaults to fallback in development)
JWT_SECRET=

# [OPTIONAL] Application port (defaults to 3000)
PORT=3000

# [OPTIONAL] Firebase Web Client Configuration (if not using local firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
